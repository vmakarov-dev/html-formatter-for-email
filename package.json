{
  "name": "html-formatter",
  "version": "0.1.0",
  "description": "Локальный офлайн-форматтер HTML-кода",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "html-formatter": "dist/bin/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:web": "tsc -p tsconfig.json && node scripts/build-web-bundle.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "cli": "tsx bin/cli.ts",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0"
  }
}
